# Server
PORT=3000
TZ=Asia/Ho_Chi_Minh
# DATA_DIRECTORY=/app/data

# Optional: set your own stable secret. If omitted, the server generates and
# persists one under DATA_DIRECTORY automatically.
# SESSION_SECRET=replace-with-a-long-random-secret
SESSION_COOKIE_SECURE=false
TRUST_PROXY=false

# Logging / maintenance. Keep disabled in production unless troubleshooting.
DEBUG_HTTP=false
DEBUG_STARTUP=false
ENABLE_DEBUG_ENDPOINTS=false
ENABLE_ADMIN_PASSWORD_RESET=false

# Webhook defaults
MESSAGE_WEBHOOK_URL=https://your-webhook-domain.com/webhook/zalo-messages
GROUP_EVENT_WEBHOOK_URL=https://your-webhook-domain.com/webhook/zalo-group-events
REACTION_WEBHOOK_URL=https://your-webhook-domain.com/webhook/zalo-reactions

# Optional proxy examples
# HTTP_PROXY=http://username:password@proxy-server:port
# HTTPS_PROXY=http://username:password@proxy-server:port

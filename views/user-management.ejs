<%- include('partials/head', { title: 'Người dùng' }) %>
<%- include('partials/header') %>
<main class="page app-shell">
  <a class="back-home" href="./">← Trang chủ</a>
  <div class="page-header"><div><h1 class="page-title">Người dùng</h1><p class="page-subtitle">Tạo tài khoản truy cập giao diện quản trị. Chức năng này chỉ dành cho admin.</p></div></div>
  <div class="grid grid-2" style="align-items:start">
    <section class="card">
      <h2 class="card-title">Thêm người dùng</h2>
      <form id="userForm" class="form-grid" style="margin-top:16px">
        <div class="form-row"><label for="newUsername">Tên đăng nhập</label><input class="input" id="newUsername" required maxlength="100" autocomplete="off"></div>
        <div class="form-row"><label for="newPassword">Mật khẩu</label><input class="input" id="newPassword" type="password" minlength="8" required autocomplete="new-password"><div class="input-help">Tối thiểu 8 ký tự.</div></div>
        <div class="form-row"><label for="newRole">Quyền</label><select class="input" id="newRole"><option value="user">User</option><option value="admin">Admin</option></select></div>
        <button class="btn btn-primary" type="submit">＋ Thêm người dùng</button>
      </form>
    </section>
    <section class="card">
      <div class="toolbar"><div><h2 class="card-title">Danh sách</h2><p class="card-text">Mật khẩu được lưu dưới dạng hash.</p></div><button class="btn btn-secondary btn-sm" id="reloadUsers">↻</button></div>
      <div id="userList" style="margin-top:15px"></div>
    </section>
  </div>
</main>
<script>
async function loadUsers(){const box=document.getElementById('userList');box.innerHTML='<div class="skeleton" style="height:70px"></div>';try{const r=await zaloUi.json('/api/users');const users=Array.isArray(r.users)?r.users:[];box.innerHTML=users.length?'':'<div class="empty">Chưa có người dùng</div>';for(const user of users){const item=document.createElement('div');item.className='card';item.style='padding:12px;margin-bottom:8px';item.innerHTML=`<div class="toolbar"><strong>${zaloUi.escape(user.username)}</strong><span class="badge ${user.role==='admin'?'badge-primary':'badge-muted'}">${zaloUi.escape(user.role||'user')}</span></div>`;box.appendChild(item);}}catch(error){box.innerHTML=`<div class="notice notice-danger">${zaloUi.escape(error.message)}</div>`;}}
document.getElementById('userForm').addEventListener('submit',async event=>{event.preventDefault();const button=event.submitter;button.disabled=true;try{await zaloUi.json('/api/users',{method:'POST',body:JSON.stringify({username:document.getElementById('newUsername').value.trim(),password:document.getElementById('newPassword').value,role:document.getElementById('newRole').value})});event.target.reset();zaloUi.toast('Đã thêm người dùng','success');await loadUsers();}catch(error){zaloUi.toast(error.message,'error');}finally{button.disabled=false;}});
document.getElementById('reloadUsers').addEventListener('click',loadUsers);loadUsers();
</script>
<%- include('partials/footer') %>

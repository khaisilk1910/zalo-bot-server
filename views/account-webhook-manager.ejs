<%- include('partials/head', { title: 'Webhook đa tài khoản' }) %>
<%- include('partials/header') %>
<main class="page app-shell">
  <a class="back-home" href="./">← Trang chủ</a>
  <div class="page-header">
    <div>
      <h1 class="page-title">Webhook</h1>
      <p class="page-subtitle">Mỗi <strong>ID Tài Khoản</strong> có thể có nhiều Webhook độc lập. Một webhook có thể nhận tin nhắn, sự kiện nhóm, reaction hoặc nhiều loại cùng lúc.</p>
    </div>
    <div class="actions" style="margin:0"><button class="btn btn-primary" id="addAccountBtn" type="button">＋ Thêm ID tài khoản</button></div>
  </div>

  <div class="notice notice-info">Mỗi ID có thể gửi cùng một sự kiện đến <strong>tất cả</strong> webhook phù hợp đang bật. Các webhook trùng URL sẽ chỉ nhận một lần cho mỗi sự kiện.</div>

  <section class="section grid" style="grid-template-columns:minmax(260px,340px) minmax(0,1fr);align-items:start" id="webhookLayout">
    <aside class="card">
      <div class="toolbar"><div><h2 class="card-title">ID tài khoản</h2><p class="card-text">Cấu hình webhook, không xóa phiên Zalo.</p></div><button class="btn btn-secondary btn-sm" id="reloadBtn">↻</button></div>
      <div id="accountList" style="display:grid;gap:8px;margin-top:15px"></div>
      <div id="suggestedAccounts" style="margin-top:18px"></div>
    </aside>

    <section class="card" id="detailPanel">
      <div class="empty"><div class="empty-icon">⌁</div><strong>Chọn một ID tài khoản</strong><p>Thêm ID mới hoặc chọn cấu hình ở cột bên trái.</p></div>
    </section>
  </section>
</main>

<div class="modal-backdrop" id="accountModal" role="dialog" aria-modal="true">
  <div class="modal">
    <div class="modal-head"><h3 id="accountModalTitle">Thêm ID tài khoản</h3><button class="icon-btn close-modal" type="button">×</button></div>
    <form id="accountForm" class="form-grid">
      <input type="hidden" id="originalOwnId">
      <div class="form-row"><label for="accountOwnId">ID Tài Khoản</label><input class="input" id="accountOwnId" maxlength="128" required placeholder="Ví dụ: 1234567890123456789"><div class="input-help">Có thể tạo cấu hình trước cả khi tài khoản Zalo chưa đăng nhập.</div></div>
      <div class="form-row"><label for="accountLabel">Tên gợi nhớ</label><input class="input" id="accountLabel" maxlength="100" placeholder="Ví dụ: Zalo Gia đình"></div>
      <div class="actions"><button class="btn btn-primary" type="submit">Lưu ID tài khoản</button><button class="btn btn-secondary close-modal" type="button">Hủy</button></div>
    </form>
  </div>
</div>

<div class="modal-backdrop" id="webhookModal" role="dialog" aria-modal="true">
  <div class="modal">
    <div class="modal-head"><h3 id="webhookModalTitle">Thêm Webhook</h3><button class="icon-btn close-webhook-modal" type="button">×</button></div>
    <form id="webhookForm" class="form-grid">
      <input type="hidden" id="webhookId">
      <div class="form-row"><label for="webhookName">Tên Webhook</label><input class="input" id="webhookName" maxlength="100" required placeholder="Ví dụ: n8n Home Assistant"></div>
      <div class="form-row"><label for="webhookUrl">URL</label><input class="input" id="webhookUrl" type="url" maxlength="4096" required placeholder="https://example.com/webhook/zalo"></div>
      <div class="form-row"><label>Nhận sự kiện</label><div class="check-grid">
        <label class="check-chip"><input type="checkbox" name="events" value="message"><span>✉ Tin nhắn</span></label>
        <label class="check-chip"><input type="checkbox" name="events" value="group_event"><span>◎ Sự kiện nhóm</span></label>
        <label class="check-chip"><input type="checkbox" name="events" value="reaction"><span>♥ Reaction</span></label>
      </div></div>
      <div class="toolbar"><div><strong>Kích hoạt</strong><div class="input-help">Webhook tắt sẽ được giữ cấu hình nhưng không nhận dữ liệu.</div></div><label class="switch"><input id="webhookEnabled" type="checkbox" checked><span></span></label></div>
      <div class="actions"><button class="btn btn-primary" type="submit">Lưu Webhook</button><button class="btn btn-secondary close-webhook-modal" type="button">Hủy</button></div>
    </form>
  </div>
</div>

<script>
const state = { accounts: [], logged: [], selected: '', detail: null };
const eventLabels = {message:'Tin nhắn', group_event:'Sự kiện nhóm', reaction:'Reaction'};
const qAccount = new URLSearchParams(location.search).get('account') || '';

const accountModal = document.getElementById('accountModal');
const webhookModal = document.getElementById('webhookModal');
const openModal = el => el.classList.add('open');
const closeModal = el => el.classList.remove('open');

document.querySelectorAll('.close-modal').forEach(b => b.addEventListener('click', () => closeModal(accountModal)));
document.querySelectorAll('.close-webhook-modal').forEach(b => b.addEventListener('click', () => closeModal(webhookModal)));
[accountModal, webhookModal].forEach(m => m.addEventListener('click', e => { if (e.target === m) closeModal(m); }));

function loggedMap() { return new Map(state.logged.map(a => [String(a.ownId), a])); }

async function loadAll(preferredId = '') {
  const [configured, logged] = await Promise.all([
    zaloUi.json('/api/webhook-accounts'),
    zaloUi.json('/api/accounts').catch(() => ({data:[]})),
  ]);
  state.accounts = Array.isArray(configured.data) ? configured.data : [];
  state.logged = Array.isArray(logged.data) ? logged.data : [];
  renderAccountList();
  const wanted = preferredId || state.selected || qAccount;
  if (wanted && state.accounts.some(a => a.ownId === wanted)) await selectAccount(wanted);
  else if (state.selected && !state.accounts.some(a => a.ownId === state.selected)) { state.selected=''; renderDetailEmpty(); }
}

function renderAccountList() {
  const list = document.getElementById('accountList'); list.innerHTML='';
  const logins = loggedMap();
  if (!state.accounts.length) list.innerHTML='<div class="empty" style="padding:18px 8px"><strong>Chưa có ID cấu hình</strong></div>';
  for (const account of state.accounts) {
    const button = document.createElement('button');
    button.type='button';
    button.className='card hover';
    button.style.cssText=`padding:12px;text-align:left;width:100%;cursor:pointer;${state.selected===account.ownId?'border-color:rgba(23,105,255,.5);background:#f4f7ff':''}`;
    const online = logins.get(account.ownId)?.isOnline;
    button.innerHTML=`<div class="toolbar"><div style="min-width:0"><strong>${zaloUi.escape(account.label || account.ownId)}</strong><div class="code" style="color:var(--muted);margin-top:3px">${zaloUi.escape(account.ownId)}</div></div><span class="badge ${online?'badge-success':'badge-muted'}">${online?'●':'○'} ${account.webhookCount}</span></div>`;
    button.addEventListener('click', () => selectAccount(account.ownId));
    list.appendChild(button);
  }
  const configuredIds = new Set(state.accounts.map(a => a.ownId));
  const suggestions = state.logged.filter(a => !configuredIds.has(String(a.ownId)));
  const wrap = document.getElementById('suggestedAccounts');
  if (!suggestions.length) { wrap.innerHTML=''; return; }
  wrap.innerHTML='<div class="input-help" style="font-weight:800;margin-bottom:8px">TÀI KHOẢN ZALO CHƯA CẤU HÌNH</div>';
  for (const account of suggestions) {
    const b=document.createElement('button'); b.type='button'; b.className='btn btn-secondary btn-sm'; b.style='width:100%;margin-bottom:7px;justify-content:flex-start'; b.textContent=`＋ ${account.phoneNumber || account.ownId} · ${account.ownId}`;
    b.addEventListener('click', () => openAccountCreate(account.ownId, account.phoneNumber || ''));
    wrap.appendChild(b);
  }
}

function renderDetailEmpty() {
  document.getElementById('detailPanel').innerHTML='<div class="empty"><div class="empty-icon">⌁</div><strong>Chọn một ID tài khoản</strong><p>Thêm ID mới hoặc chọn cấu hình ở cột bên trái.</p></div>';
}

async function selectAccount(ownId) {
  state.selected = ownId; renderAccountList();
  const panel = document.getElementById('detailPanel'); panel.innerHTML='<div class="skeleton" style="height:160px"></div>';
  try {
    const response = await zaloUi.json(`/api/webhook-accounts/${encodeURIComponent(ownId)}`);
    state.detail = response.data; renderDetail();
  } catch (error) { panel.innerHTML=`<div class="notice notice-danger">${zaloUi.escape(error.message)}</div>`; }
}

function renderDetail() {
  const data = state.detail; const panel = document.getElementById('detailPanel');
  const logged = loggedMap().get(data.ownId);
  panel.innerHTML=`
    <div class="toolbar">
      <div><div class="eyebrow">${logged?.isOnline?'● Zalo đang hoạt động':'○ ID cấu hình'}</div><h2 style="margin:10px 0 3px;font-size:27px">${zaloUi.escape(data.label || 'ID Tài Khoản')}</h2><div class="code" style="color:var(--muted)">${zaloUi.escape(data.ownId)}</div></div>
      <div class="actions" style="margin:0"><button class="btn btn-secondary btn-sm" id="editAccount">Sửa ID</button><button class="btn btn-danger btn-sm" id="deleteAccount">Xóa ID</button></div>
    </div>
    <div class="section-title" style="margin-top:24px"><div><h2>Webhook (${data.webhooks.length})</h2><p class="card-text">Tối đa 50 webhook cho mỗi ID.</p></div><button class="btn btn-primary" id="addWebhook">＋ Thêm Webhook</button></div>
    <div id="webhookCards" class="grid"></div>`;
  document.getElementById('editAccount').addEventListener('click', () => openAccountEdit(data));
  document.getElementById('deleteAccount').addEventListener('click', deleteSelectedAccount);
  document.getElementById('addWebhook').addEventListener('click', () => openWebhookCreate());
  const cards = document.getElementById('webhookCards');
  if (!data.webhooks.length) { cards.innerHTML='<div class="empty"><div class="empty-icon">＋</div><strong>Chưa có Webhook</strong><p>Thêm webhook đầu tiên cho ID tài khoản này.</p></div>'; return; }
  for (const wh of data.webhooks) {
    const card=document.createElement('article'); card.className='card hover';
    card.innerHTML=`<div class="toolbar"><div style="min-width:0"><div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap"><h3 class="card-title" style="margin:0">${zaloUi.escape(wh.name)}</h3><span class="badge ${wh.enabled?'badge-success':'badge-muted'}">${wh.enabled?'Đang bật':'Đang tắt'}</span></div><div class="code" style="margin-top:8px;color:var(--muted)">${zaloUi.escape(wh.url)}</div><div class="actions" style="margin-top:10px">${wh.events.map(e=>`<span class="badge badge-primary">${zaloUi.escape(eventLabels[e]||e)}</span>`).join('')}</div></div><div class="actions" style="margin:0"><button class="btn btn-secondary btn-sm test-wh" data-id="${zaloUi.escape(wh.id)}">Thử</button><button class="btn btn-ghost btn-sm edit-wh" data-id="${zaloUi.escape(wh.id)}">Sửa</button><button class="btn btn-danger btn-sm delete-wh" data-id="${zaloUi.escape(wh.id)}">Xóa</button></div></div>`;
    cards.appendChild(card);
  }
  cards.querySelectorAll('.test-wh').forEach(b=>b.addEventListener('click',()=>testWebhook(b.dataset.id,b)));
  cards.querySelectorAll('.edit-wh').forEach(b=>b.addEventListener('click',()=>openWebhookEdit(data.webhooks.find(w=>w.id===b.dataset.id))));
  cards.querySelectorAll('.delete-wh').forEach(b=>b.addEventListener('click',()=>deleteWebhook(b.dataset.id)));
}

function openAccountCreate(ownId='', label='') { document.getElementById('accountModalTitle').textContent='Thêm ID tài khoản'; document.getElementById('originalOwnId').value=''; document.getElementById('accountOwnId').value=ownId; document.getElementById('accountOwnId').readOnly=false; document.getElementById('accountLabel').value=label; openModal(accountModal); }
function openAccountEdit(data) { document.getElementById('accountModalTitle').textContent='Sửa ID tài khoản'; document.getElementById('originalOwnId').value=data.ownId; document.getElementById('accountOwnId').value=data.ownId; document.getElementById('accountOwnId').readOnly=false; document.getElementById('accountLabel').value=data.label||''; openModal(accountModal); }
document.getElementById('addAccountBtn').addEventListener('click',()=>openAccountCreate());
document.getElementById('reloadBtn').addEventListener('click',()=>loadAll(state.selected).catch(e=>zaloUi.toast(e.message,'error')));

document.getElementById('accountForm').addEventListener('submit', async event => {
  event.preventDefault(); const original=document.getElementById('originalOwnId').value; const ownId=document.getElementById('accountOwnId').value.trim(); const label=document.getElementById('accountLabel').value.trim(); const button=event.submitter; button.disabled=true;
  try {
    if (original) await zaloUi.json(`/api/webhook-accounts/${encodeURIComponent(original)}`, {method:'PUT',body:JSON.stringify({ownId,label})});
    else await zaloUi.json('/api/webhook-accounts',{method:'POST',body:JSON.stringify({ownId,label})});
    closeModal(accountModal); state.selected=ownId; zaloUi.toast(original?'Đã cập nhật ID tài khoản':'Đã thêm ID tài khoản','success'); await loadAll(ownId);
  } catch (error) { zaloUi.toast(error.message,'error'); } finally { button.disabled=false; }
});

async function deleteSelectedAccount() {
  if (!zaloUi.confirm(`Xóa cấu hình ID ${state.selected} và toàn bộ webhook của ID này? Phiên Zalo không bị xóa.`)) return;
  try { await zaloUi.json(`/api/webhook-accounts/${encodeURIComponent(state.selected)}`,{method:'DELETE'}); state.selected=''; state.detail=null; zaloUi.toast('Đã xóa cấu hình ID tài khoản','success'); renderDetailEmpty(); await loadAll(); }
  catch(error){zaloUi.toast(error.message,'error');}
}

function openWebhookCreate() { document.getElementById('webhookModalTitle').textContent='Thêm Webhook'; document.getElementById('webhookId').value=''; document.getElementById('webhookName').value=''; document.getElementById('webhookUrl').value=''; document.querySelectorAll('#webhookForm input[name="events"]').forEach(i=>i.checked=i.value==='message'); document.getElementById('webhookEnabled').checked=true; openModal(webhookModal); }
function openWebhookEdit(wh) { document.getElementById('webhookModalTitle').textContent='Sửa Webhook'; document.getElementById('webhookId').value=wh.id; document.getElementById('webhookName').value=wh.name||''; document.getElementById('webhookUrl').value=wh.url||''; document.querySelectorAll('#webhookForm input[name="events"]').forEach(i=>i.checked=wh.events.includes(i.value)); document.getElementById('webhookEnabled').checked=wh.enabled!==false; openModal(webhookModal); }

document.getElementById('webhookForm').addEventListener('submit', async event => {
  event.preventDefault(); const id=document.getElementById('webhookId').value; const events=[...document.querySelectorAll('#webhookForm input[name="events"]:checked')].map(i=>i.value); if(!events.length){zaloUi.toast('Hãy chọn ít nhất một loại sự kiện','warning');return;}
  const payload={name:document.getElementById('webhookName').value.trim(),url:document.getElementById('webhookUrl').value.trim(),events,enabled:document.getElementById('webhookEnabled').checked}; const button=event.submitter; button.disabled=true;
  try { const path=id?`/api/webhook-accounts/${encodeURIComponent(state.selected)}/webhooks/${encodeURIComponent(id)}`:`/api/webhook-accounts/${encodeURIComponent(state.selected)}/webhooks`; await zaloUi.json(path,{method:id?'PUT':'POST',body:JSON.stringify(payload)}); closeModal(webhookModal); zaloUi.toast(id?'Đã cập nhật Webhook':'Đã thêm Webhook','success'); await selectAccount(state.selected); await loadAll(state.selected); }
  catch(error){zaloUi.toast(error.message,'error');} finally{button.disabled=false;}
});

async function deleteWebhook(id){ if(!zaloUi.confirm('Xóa webhook này?'))return; try{await zaloUi.json(`/api/webhook-accounts/${encodeURIComponent(state.selected)}/webhooks/${encodeURIComponent(id)}`,{method:'DELETE'});zaloUi.toast('Đã xóa Webhook','success');await selectAccount(state.selected);await loadAll(state.selected);}catch(error){zaloUi.toast(error.message,'error');}}
async function testWebhook(id,button){button.disabled=true;try{await zaloUi.json(`/api/webhook-accounts/${encodeURIComponent(state.selected)}/webhooks/${encodeURIComponent(id)}/test`,{method:'POST'});zaloUi.toast('Webhook phản hồi thành công','success');}catch(error){zaloUi.toast(error.message,'error');}finally{button.disabled=false;}}

loadAll().catch(error => { document.getElementById('accountList').innerHTML=`<div class="notice notice-danger">${zaloUi.escape(error.message)}</div>`; });
</script>
<style>@media(max-width:820px){#webhookLayout{grid-template-columns:1fr!important}}</style>
<%- include('partials/footer') %>

<%- include('partials/head', { title: 'Đổi mật khẩu' }) %>
<%- include('partials/header') %>
<main class="page app-shell">
  <a class="back-home" href="./">← Trang chủ</a>
  <div class="page-header"><div><h1 class="page-title">Đổi mật khẩu</h1><p class="page-subtitle">Cập nhật mật khẩu cho tài khoản quản trị đang đăng nhập. Mật khẩu mới cần ít nhất 8 ký tự.</p></div></div>
  <section class="card" style="max-width:620px">
    <form id="passwordForm" class="form-grid">
      <div class="form-row"><label for="oldPassword">Mật khẩu hiện tại</label><input class="input" id="oldPassword" type="password" autocomplete="current-password" required></div>
      <div class="form-row"><label for="newPassword">Mật khẩu mới</label><input class="input" id="newPassword" type="password" autocomplete="new-password" minlength="8" required></div>
      <div class="form-row"><label for="confirmPassword">Nhập lại mật khẩu mới</label><input class="input" id="confirmPassword" type="password" autocomplete="new-password" minlength="8" required></div>
      <div class="actions"><button class="btn btn-primary" type="submit">Lưu mật khẩu mới</button><a class="btn btn-secondary" href="./">Hủy</a></div>
    </form>
    <div id="passwordMessage" style="margin-top:14px"></div>
  </section>
</main>
<script>
document.getElementById('passwordForm').addEventListener('submit',async event=>{event.preventDefault();const oldPassword=document.getElementById('oldPassword').value;const newPassword=document.getElementById('newPassword').value;const confirm=document.getElementById('confirmPassword').value;const box=document.getElementById('passwordMessage');if(newPassword!==confirm){box.innerHTML='<div class="notice notice-danger">Mật khẩu nhập lại không khớp.</div>';return;}const button=event.submitter;button.disabled=true;try{const r=await zaloUi.json('/api/change-password',{method:'POST',body:JSON.stringify({oldPassword,newPassword})});box.innerHTML=`<div class="notice notice-success">${zaloUi.escape(r.message||'Đã đổi mật khẩu')}</div>`;event.target.reset();}catch(error){box.innerHTML=`<div class="notice notice-danger">${zaloUi.escape(error.message)}</div>`;}finally{button.disabled=false;}});
</script>
<%- include('partials/footer') %>

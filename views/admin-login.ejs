<%- include('partials/head', { title: 'Đăng nhập quản trị' }) %>
<main class="page app-shell" style="min-height:90vh;display:grid;place-items:center">
  <section class="card" style="width:min(460px,100%);padding:28px">
    <a class="back-home" href="./">← Trang chủ</a>
    <a class="brand" href="./" style="margin-bottom:22px"><span class="brand-mark">Z</span><span>Zalo Bot Server</span></a>
    <h1 style="margin:0;font-size:30px;letter-spacing:-.04em">Đăng nhập quản trị</h1>
    <p class="card-text" style="margin-top:8px">Đăng nhập để truy cập tài khoản Zalo, webhook, proxy và API.</p>
    <form id="loginForm" class="form-grid" style="margin-top:22px">
      <div class="form-row"><label for="username">Tài khoản</label><input class="input" id="username" autocomplete="username" required autofocus></div>
      <div class="form-row"><label for="password">Mật khẩu</label><input class="input" id="password" type="password" autocomplete="current-password" required></div>
      <button class="btn btn-primary" type="submit">Đăng nhập</button>
    </form>
    <div id="loginMessage" style="margin-top:14px"></div>
  </section>
</main>
<script>
document.getElementById('loginForm').addEventListener('submit', async event => {
  event.preventDefault(); const button=event.submitter; const box=document.getElementById('loginMessage'); button.disabled=true; box.innerHTML='';
  try { await zaloUi.json('/api/login',{method:'POST',body:JSON.stringify({username:document.getElementById('username').value.trim(),password:document.getElementById('password').value})}); window.location.href='./'; }
  catch(error){ box.innerHTML=`<div class="notice notice-danger">${zaloUi.escape(error.message||'Đăng nhập thất bại')}</div>`; }
  finally{button.disabled=false;}
});
</script>
<%- include('partials/footer') %>

<%- include('partials/head', { title: 'Đăng nhập Zalo' }) %>
<%- include('partials/header') %>
<main class="page app-shell">
  <a class="back-home" href="./">← Trang chủ</a>
  <div class="page-header">
    <div><h1 class="page-title">Đăng nhập Zalo</h1><p class="page-subtitle">Tạo mã QR cho một phiên đăng nhập mới. Proxy là tùy chọn; để trống nếu muốn kết nối trực tiếp.</p></div>
  </div>
  <div class="grid grid-2" style="align-items:start">
    <section class="card">
      <h2 class="card-title">Tạo mã QR</h2>
      <form id="loginForm" class="form-grid" style="margin-top:16px">
        <div class="form-row"><label for="proxy">Proxy HTTP/HTTPS</label><input class="input" type="text" id="proxy" placeholder="http://user:pass@host:port"><div class="input-help">Nếu để trống, server tự dùng kết nối trực tiếp hoặc logic proxy đã cấu hình.</div></div>
        <button class="btn btn-primary" id="login-button" type="submit">Tạo mã QR</button>
      </form>
      <div id="status-message" class="notice notice-info" style="display:none;margin-top:16px"></div>
    </section>
    <section class="card" id="qr-container">
      <div class="empty" id="qr-empty"><div class="empty-icon">▣</div><strong>Chưa có mã QR</strong><p>Nhấn “Tạo mã QR”, sau đó quét bằng ứng dụng Zalo trên điện thoại.</p></div>
      <div id="qr-code" style="display:none;text-align:center"></div>
    </section>
  </div>
</main>
<script>
let socket = null;
let countdownInterval = null;
const statusMessage = document.getElementById('status-message');
const loginButton = document.getElementById('login-button');
function setStatus(type, text) {
  statusMessage.style.display='block'; statusMessage.className=`notice notice-${type}`; statusMessage.textContent=text;
}
function buildWebSocketUrl() {
  const url=new URL(window.location.href); url.protocol=url.protocol==='https:'?'wss:':'ws:';
  const normalized=url.pathname.replace(/\/+$/,''); const slash=normalized.lastIndexOf('/'); const base=slash>=0?normalized.slice(0,slash):'';
  url.pathname=`${base}/ws`.replace(/\/{2,}/g,'/'); url.search=''; url.hash=''; return url.toString();
}
function connectWebSocket() {
  if (socket) { try { socket.close(); } catch {} }
  try { socket=new WebSocket(buildWebSocketUrl()); }
  catch { setStatus('danger','Không thể tạo kết nối WebSocket.'); return; }
  socket.onopen=()=>{ if (!statusMessage.textContent.includes('Đăng nhập thành công')) setStatus('info','Đã kết nối. Hãy quét QR và xác nhận trên điện thoại.'); };
  socket.onmessage=(event)=>{
    if(event.data!=='login_success') return;
    let seconds=3; statusMessage.style.display='block'; statusMessage.className='notice notice-success'; statusMessage.textContent=`Đăng nhập thành công. Về trang chủ sau ${seconds} giây...`;
    clearInterval(countdownInterval); countdownInterval=setInterval(()=>{ seconds-=1; statusMessage.textContent=`Đăng nhập thành công. Về trang chủ sau ${Math.max(0,seconds)} giây...`; if(seconds<=0){clearInterval(countdownInterval);window.location.href='./';}},1000);
  };
  socket.onerror=()=>setStatus('warning','WebSocket đang gặp lỗi kết nối. Server sẽ vẫn tiếp tục xử lý QR.');
  socket.onclose=()=>{ if(!statusMessage.textContent.includes('Đăng nhập thành công')) setStatus('warning','WebSocket đã đóng. Tạo lại QR nếu cần.'); };
}
document.getElementById('loginForm').addEventListener('submit', async event => {
  event.preventDefault(); loginButton.disabled=true; loginButton.textContent='Đang tạo QR...'; setStatus('info','Đang tạo mã QR, vui lòng đợi...');
  try {
    const data=await zaloUi.json('/zalo-login',{method:'POST',body:JSON.stringify({proxy:document.getElementById('proxy').value.trim()})});
    if(!data.success||!data.qrCodeImage) throw new Error(data.error||'Không nhận được mã QR hợp lệ');
    const box=document.getElementById('qr-code'); box.replaceChildren(); const img=document.createElement('img'); img.src=data.qrCodeImage; img.alt='Mã QR Zalo'; img.style.cssText='max-width:min(360px,100%);height:auto;border-radius:18px;border:1px solid var(--line);box-shadow:var(--shadow-soft)'; box.appendChild(img); box.style.display='block'; document.getElementById('qr-empty').style.display='none';
    setStatus('info','Hãy quét mã QR bằng ứng dụng Zalo và xác nhận đăng nhập.'); connectWebSocket(); loginButton.textContent='Tạo mã QR mới';
  } catch(error) { setStatus('danger',error.message||'Không thể tạo mã QR'); loginButton.textContent='Tạo mã QR'; }
  finally { loginButton.disabled=false; }
});
window.addEventListener('beforeunload',()=>{ if(socket) socket.close(); clearInterval(countdownInterval); });
</script>
<%- include('partials/footer') %>

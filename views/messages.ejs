<%- include('partials/head', { title: 'Theo dõi tin nhắn' }) %>
<%- include('partials/header') %>
<main class="page app-shell">
  <a class="back-home" href="./">← Trang chủ</a>
  <div class="page-header">
    <div><h1 class="page-title">Theo dõi tin nhắn</h1><p class="page-subtitle">Nhận sự kiện Zalo qua WebSocket theo thời gian thực và sao chép thread_id để dùng trong Home Assistant hoặc API.</p></div>
    <button id="clearBtn" class="btn btn-danger" type="button">Xóa tất cả</button>
  </div>
  <div class="grid" style="grid-template-columns:minmax(0,2fr) minmax(280px,1fr);align-items:start" id="messageLayout">
    <section class="card">
      <div class="section-title"><h2>Tin nhắn gần đây</h2><span class="badge badge-primary">Tối đa 250</span></div>
      <div id="connection-alert" class="notice notice-info" role="status">Đang kết nối với server...</div>
      <div id="messages" style="display:grid;gap:10px;max-height:620px;overflow:auto;margin-top:12px;padding-right:3px"></div>
    </section>
    <aside class="card">
      <h2 class="card-title">Thread ID</h2>
      <p class="card-text">Nhấp vào Thread ID trong tin nhắn để sao chép. Thread ID của người dùng và nhóm là khác nhau.</p>
      <div class="notice notice-warning" style="margin-top:14px">Sử dụng đúng <strong>thread_id</strong> và loại thread khi gửi tin từ Home Assistant.</div>
      <div class="form-row" style="margin-top:18px"><label for="copiedThreadId">Thread ID đã sao chép</label><input class="input code" type="text" id="copiedThreadId" readonly><button class="btn btn-secondary" type="button" id="copyAgain">Sao chép lại</button></div>
    </aside>
  </div>
</main>
<style>
.thread-id{font-weight:800;color:var(--primary);cursor:pointer;overflow-wrap:anywhere}.thread-id:hover{text-decoration:underline}#messages p{margin:5px 0;line-height:1.45}@media(max-width:820px){#messageLayout{grid-template-columns:1fr!important}}
</style>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const messagesContainer = document.getElementById('messages');
            const connectionAlert = document.getElementById('connection-alert');
            const clearBtn = document.getElementById('clearBtn');
            const copiedThreadIdInput = document.getElementById('copiedThreadId');
            const copyAgainBtn = document.getElementById('copyAgain');

            const statusIndicator = document.createElement('div');
            statusIndicator.id = 'connection-status';
            statusIndicator.className = 'badge badge-warning'; statusIndicator.style.cssText = 'position:fixed;left:14px;bottom:14px;z-index:90;';
            statusIndicator.textContent = 'Đang kết nối...';
            document.body.appendChild(statusIndicator);

            const MAX_MESSAGES = 250;
            let socket = null;
            let reconnectTimer = null;
            let reconnectAttempts = 0;
            let stopped = false;
            let messageSequence = 0;
            const messagesHistory = [];

            function buildWebSocketUrl() {
                const url = new URL(window.location.href);
                url.protocol = url.protocol === 'https:' ? 'wss:' : 'ws:';

                // Giữ prefix của reverse proxy/Home Assistant ingress, chỉ thay
                // segment cuối (/messages) bằng /ws.
                const normalizedPath = url.pathname.replace(/\/+$/, '');
                const lastSlash = normalizedPath.lastIndexOf('/');
                const basePath = lastSlash >= 0 ? normalizedPath.slice(0, lastSlash) : '';
                url.pathname = `${basePath}/ws`.replace(/\/{2,}/g, '/');
                url.search = '';
                url.hash = '';
                return url.toString();
            }

            function setConnectionState(state, message) {
                const styles = {
                    connecting: ['notice-info', 'badge-primary'],
                    connected: ['notice-success', 'badge-success'],
                    disconnected: ['notice-warning', 'badge-warning'],
                    auth: ['notice-warning', 'badge-warning']
                };
                const [alertClass, badgeClass] = styles[state] || styles.connecting;
                connectionAlert.className = `notice ${alertClass}`;
                connectionAlert.textContent = message;
                statusIndicator.className = `badge ${state === 'connected' ? 'badge-success' : state === 'disconnected' ? 'badge-warning' : 'badge-primary'}`;
                statusIndicator.style.cssText = 'position:fixed;left:14px;bottom:14px;z-index:90;';
                statusIndicator.textContent = message;
            }

            async function sessionIsAuthenticated() {
                try {
                    const response = await fetch('api/check-auth', {
                        method: 'GET',
                        credentials: 'same-origin',
                        cache: 'no-store',
                        headers: { 'Accept': 'application/json' }
                    });
                    if (!response.ok) return true;
                    const data = await response.json();
                    return data.authenticated !== false;
                } catch (_) {
                    // Không biến lỗi mạng tạm thời thành lỗi xác thực.
                    return true;
                }
            }

            function scheduleReconnect() {
                if (stopped || reconnectTimer) return;
                reconnectAttempts += 1;
                const delay = Math.min(1000 * (2 ** Math.min(reconnectAttempts - 1, 5)), 30000);
                const seconds = Math.max(1, Math.round(delay / 1000));
                setConnectionState('disconnected', `Mất kết nối - thử lại sau ${seconds} giây`);
                reconnectTimer = window.setTimeout(() => {
                    reconnectTimer = null;
                    connectWebSocket();
                }, delay);
            }

            function connectWebSocket() {
                if (stopped) return;
                if (socket && (socket.readyState === WebSocket.OPEN || socket.readyState === WebSocket.CONNECTING)) {
                    return;
                }

                const wsUrl = buildWebSocketUrl();
                setConnectionState('connecting', reconnectAttempts > 0
                    ? `Đang kết nối lại (lần ${reconnectAttempts})...`
                    : 'Đang kết nối với server...');

                try {
                    socket = new WebSocket(wsUrl);
                } catch (error) {
                    console.error('Không thể tạo WebSocket:', error);
                    scheduleReconnect();
                    return;
                }

                socket.onopen = function() {
                    reconnectAttempts = 0;
                    if (reconnectTimer) {
                        clearTimeout(reconnectTimer);
                        reconnectTimer = null;
                    }
                    setConnectionState('connected', 'Đã kết nối');
                };

                socket.onmessage = function(event) {
                    // Tín hiệu này dành cho trang đăng nhập QR, không phải tin nhắn.
                    if (event.data === 'login_success') return;

                    try {
                        const data = JSON.parse(event.data);
                        addMessageToDisplay(data);
                    } catch (error) {
                        console.warn('Bỏ qua dữ liệu WebSocket không phải JSON:', error);
                    }
                };

                socket.onerror = function(error) {
                    // onclose sẽ xử lý reconnect; không tạo thêm banner lỗi ở đây.
                    console.warn('WebSocket error:', error);
                };

                socket.onclose = async function() {
                    socket = null;
                    if (stopped) return;

                    if (!(await sessionIsAuthenticated())) {
                        stopped = true;
                        setConnectionState('auth', 'Phiên đăng nhập đã hết hạn - vui lòng đăng nhập lại');
                        return;
                    }
                    scheduleReconnect();
                };
            }

            function appendTextRow(container, label, value, className) {
                const row = document.createElement('p');
                if (label) {
                    const strong = document.createElement('strong');
                    strong.textContent = `${label}: `;
                    row.appendChild(strong);
                }
                const text = document.createElement('span');
                if (className) text.className = className;
                text.textContent = value == null ? '' : String(value);
                row.appendChild(text);
                container.appendChild(row);
                return text;
            }

            function valueToText(value) {
                if (value == null) return '';
                if (typeof value === 'string' || typeof value === 'number' || typeof value === 'boolean') {
                    return String(value);
                }
                try { return JSON.stringify(value); } catch (_) { return String(value); }
            }

            function addMessageToDisplay(data) {
                if (!data || typeof data !== 'object') return;

                messagesHistory.push(data);
                if (messagesHistory.length > MAX_MESSAGES) messagesHistory.shift();

                const messageDiv = document.createElement('div');
                messageDiv.className = 'card'; messageDiv.style.padding = '14px';
                messageSequence += 1;

                const threadId = data.threadId ?? data.fromThreadId;
                if (threadId != null && threadId !== '') {
                    const threadElement = appendTextRow(messageDiv, 'Thread ID', threadId, 'thread-id');
                    threadElement.dataset.threadId = String(threadId);
                    threadElement.title = 'Nhấp để sao chép Thread ID';
                    threadElement.addEventListener('click', () => copyThreadId(String(threadId)));
                }

                if (data.message != null && data.message !== '') {
                    appendTextRow(messageDiv, 'Tin nhắn', valueToText(data.message));
                }

                if (data.fromUser != null) {
                    const fromUser = typeof data.fromUser === 'object'
                        ? (data.fromUser.name ?? data.fromUser.displayName ?? valueToText(data.fromUser))
                        : data.fromUser;
                    appendTextRow(messageDiv, 'Từ', valueToText(fromUser));
                }

                if (data._accountId != null) {
                    appendTextRow(messageDiv, 'Tài khoản bot', data._accountId);
                }

                const timeRow = document.createElement('p');
                timeRow.className = 'input-help';
                timeRow.textContent = `Nhận lúc: ${new Date().toLocaleTimeString()}`;
                messageDiv.appendChild(timeRow);

                const details = document.createElement('details');
                details.style.marginTop = '10px';
                const summary = document.createElement('summary');
                summary.className = 'btn btn-secondary btn-sm';
                summary.textContent = 'Xem chi tiết';
                const pre = document.createElement('pre');
                pre.className = 'code'; pre.style.cssText = 'white-space:pre-wrap;overflow:auto;background:#f7f9fc;border:1px solid var(--line);padding:12px;border-radius:12px;margin-top:8px';
                pre.textContent = JSON.stringify(data, null, 2);
                details.append(summary, pre);
                messageDiv.appendChild(details);

                messagesContainer.prepend(messageDiv);
                while (messagesContainer.children.length > MAX_MESSAGES) {
                    messagesContainer.removeChild(messagesContainer.lastElementChild);
                }
            }

            async function writeClipboard(text) {
                if (navigator.clipboard && window.isSecureContext) {
                    await navigator.clipboard.writeText(text);
                    return;
                }
                copiedThreadIdInput.focus();
                copiedThreadIdInput.select();
                if (!document.execCommand('copy')) throw new Error('Clipboard API unavailable');
            }

            function showCopiedToast(threadId) {
                zaloUi.toast(`Đã sao chép Thread ID: ${threadId}`, 'success');
            }

            async function copyThreadId(threadId) {
                copiedThreadIdInput.value = threadId;
                copiedThreadIdInput.focus();
                copiedThreadIdInput.select();
                try {
                    await writeClipboard(threadId);
                    showCopiedToast(threadId);
                } catch (error) {
                    console.error('Không thể sao chép:', error);
                    alert('Đã chọn Thread ID. Sử dụng Ctrl+C để sao chép');
                }
            }

            clearBtn.addEventListener('click', function() {
                messagesContainer.replaceChildren();
                messagesHistory.length = 0;
            });

            copyAgainBtn.addEventListener('click', function() {
                if (copiedThreadIdInput.value) copyThreadId(copiedThreadIdInput.value);
            });

            window.addEventListener('online', () => {
                if (!stopped && (!socket || socket.readyState === WebSocket.CLOSED)) {
                    if (reconnectTimer) {
                        clearTimeout(reconnectTimer);
                        reconnectTimer = null;
                    }
                    connectWebSocket();
                }
            });

            window.addEventListener('beforeunload', () => {
                stopped = true;
                if (reconnectTimer) clearTimeout(reconnectTimer);
                if (socket) socket.close(1000, 'Page unloading');
            });

            connectWebSocket();
        });
    </script>

<%- include('partials/footer') %>

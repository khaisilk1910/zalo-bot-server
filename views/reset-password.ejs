<%- include('partials/head', { title: 'Đặt lại mật khẩu admin' }) %>
<%- include('partials/header') %>
<main class="page app-shell">
  <a class="back-home" href="./">← Trang chủ</a>
  <div class="page-header"><div><h1 class="page-title">Đặt lại mật khẩu admin</h1><p class="page-subtitle">Chỉ khả dụng khi ENABLE_ADMIN_PASSWORD_RESET=true và phiên hiện tại có quyền admin.</p></div></div>
  <section class="card" style="max-width:620px">
    <div class="notice notice-warning" style="margin-bottom:16px">Đây là chức năng khôi phục có chủ đích. Sau khi hoàn tất, hãy tắt ENABLE_ADMIN_PASSWORD_RESET.</div>
    <form id="resetForm" class="form-grid">
      <div class="form-row"><label for="newPassword">Mật khẩu admin mới</label><input class="input" id="newPassword" type="password" minlength="8" required autocomplete="new-password"></div>
      <div class="form-row"><label for="confirmPassword">Nhập lại mật khẩu</label><input class="input" id="confirmPassword" type="password" minlength="8" required autocomplete="new-password"></div>
      <button class="btn btn-danger" type="submit">Đặt lại mật khẩu admin</button>
    </form>
  </section>
</main>
<script>
document.getElementById('resetForm').addEventListener('submit',async event=>{event.preventDefault();const p=document.getElementById('newPassword').value;if(p!==document.getElementById('confirmPassword').value){zaloUi.toast('Mật khẩu nhập lại không khớp','error');return;}const b=event.submitter;b.disabled=true;try{const r=await zaloUi.json('/api/reset-admin-password',{method:'POST',body:JSON.stringify({newPassword:p})});zaloUi.toast(r.message||'Đã đặt lại mật khẩu','success');event.target.reset();}catch(e){zaloUi.toast(e.message,'error');}finally{b.disabled=false;}});
</script>
<%- include('partials/footer') %>

<%- include('partials/head', { title: 'Quản lý Proxy' }) %>
<%- include('partials/header') %>
<main class="page app-shell">
  <a class="back-home" href="./">← Trang chủ</a>
  <div class="page-header">
    <div>
      <h1 class="page-title">Proxy</h1>
      <p class="page-subtitle">Quản lý proxy HTTP/HTTPS dùng khi đăng nhập Zalo. Server vẫn có thể hoạt động trực tiếp khi không cấu hình proxy.</p>
    </div>
  </div>

  <div class="grid grid-2">
    <section class="card">
      <h2 class="card-title">Thêm proxy</h2>
      <p class="card-text">Hỗ trợ <span class="kbd">http://</span> và <span class="kbd">https://</span>, có thể kèm username/password.</p>
      <form id="proxyForm" class="form-grid" style="margin-top:16px">
        <div class="form-row"><label for="proxyUrl">Proxy URL</label><input class="input" id="proxyUrl" autocomplete="off" placeholder="http://user:password@host:port" required></div>
        <button class="btn btn-primary" type="submit">＋ Thêm proxy</button>
      </form>
    </section>
    <section class="card stat">
      <div class="stat-value" id="proxyTotal">…</div><div class="stat-label">Proxy đã cấu hình</div>
      <div style="height:12px"></div>
      <div class="stat-value" id="proxyUsage">…</div><div class="stat-label">Lượt gán tài khoản hiện tại</div>
    </section>
  </div>

  <section class="section card">
    <div class="toolbar"><div><h2 class="card-title">Danh sách proxy</h2><p class="card-text">Xóa proxy không tự đăng xuất tài khoản đang hoạt động.</p></div><button class="btn btn-secondary" id="reloadProxies">↻ Làm mới</button></div>
    <div id="proxyList" class="grid grid-2" style="margin-top:16px"></div>
  </section>
</main>
<script>
async function loadProxies() {
  const list = document.getElementById('proxyList');
  list.innerHTML = '<div class="skeleton" style="height:100px"></div><div class="skeleton" style="height:100px"></div>';
  try {
    const response = await zaloUi.json('/api/proxies');
    const proxies = Array.isArray(response.data) ? response.data : [];
    document.getElementById('proxyTotal').textContent = proxies.length;
    document.getElementById('proxyUsage').textContent = proxies.reduce((sum, p) => sum + Number(p.usedCount || 0), 0);
    list.innerHTML = '';
    if (!proxies.length) {
      list.innerHTML = '<div class="empty" style="grid-column:1/-1"><div class="empty-icon">◌</div><strong>Chưa có proxy</strong><p>Thêm proxy nếu bạn cần tách kết nối cho các tài khoản.</p></div>';
      return;
    }
    for (const proxy of proxies) {
      const card = document.createElement('article'); card.className = 'card hover';
      card.innerHTML = `<div class="toolbar"><div style="min-width:0"><h3 class="card-title code" style="word-break:break-all">${zaloUi.escape(proxy.url)}</h3><p class="card-text">${Number(proxy.usedCount || 0)} tài khoản đang gán</p></div><button class="btn btn-danger btn-sm delete-proxy" data-url="${zaloUi.escape(proxy.url)}">Xóa</button></div>${Array.isArray(proxy.accounts) && proxy.accounts.length ? `<div class="actions">${proxy.accounts.map(id => `<span class="badge badge-primary code">${zaloUi.escape(id)}</span>`).join('')}</div>` : ''}`;
      list.appendChild(card);
    }
  } catch (error) { list.innerHTML = `<div class="notice notice-danger" style="grid-column:1/-1">${zaloUi.escape(error.message)}</div>`; }
}
document.getElementById('proxyForm').addEventListener('submit', async (event) => {
  event.preventDefault(); const input = document.getElementById('proxyUrl'); const button = event.submitter; button.disabled = true;
  try { await zaloUi.json('/api/proxies', {method:'POST', body:JSON.stringify({proxyUrl:input.value.trim()})}); input.value=''; zaloUi.toast('Đã thêm proxy', 'success'); await loadProxies(); }
  catch (error) { zaloUi.toast(error.message, 'error'); }
  finally { button.disabled = false; }
});
document.getElementById('reloadProxies').addEventListener('click', loadProxies);
document.addEventListener('click', async (event) => {
  const button = event.target.closest('.delete-proxy'); if (!button) return;
  if (!zaloUi.confirm('Xóa proxy này khỏi cấu hình?')) return;
  button.disabled = true;
  try { await zaloUi.json('/api/proxies', {method:'DELETE', body:JSON.stringify({proxyUrl:button.dataset.url})}); zaloUi.toast('Đã xóa proxy', 'success'); await loadProxies(); }
  catch (error) { zaloUi.toast(error.message, 'error'); button.disabled = false; }
});
loadProxies();
</script>
<%- include('partials/footer') %>

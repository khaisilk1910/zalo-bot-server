<%- include('partials/head', { title: 'Tổng quan' }) %>
<%- include('partials/header') %>
<main class="page app-shell">
  <section class="hero">
    <span class="eyebrow">● Hệ thống quản lý đa tài khoản</span>
    <h1>Zalo Bot Server</h1>
    <p>Đăng nhập nhiều tài khoản Zalo, theo dõi tin nhắn thời gian thực, quản lý proxy, webhook nhiều đích đến và sử dụng đầy đủ API từ một giao diện thống nhất.</p>
    <div class="hero-actions">
      <% if (authenticated) { %>
        <a class="btn btn-primary" href="./zalo-login">＋ Thêm tài khoản Zalo</a>
        <a class="btn btn-secondary" href="./messages">◉ Theo dõi tin nhắn</a>
        <a class="btn btn-secondary" href="./account-webhook-manager">⌁ Quản lý Webhook</a>
      <% } else { %>
        <a class="btn btn-primary" href="./admin-login">Đăng nhập quản trị</a>
      <% } %>
    </div>
  </section>

  <% if (authenticated) { %>
  <section class="section grid grid-4" aria-label="Trạng thái hệ thống">
    <article class="card stat"><div class="stat-value" id="statAccounts">…</div><div class="stat-label">Tài khoản Zalo đang nạp</div></article>
    <article class="card stat"><div class="stat-value" id="statWebhookAccounts">…</div><div class="stat-label">ID có cấu hình Webhook</div></article>
    <article class="card stat"><div class="stat-value" id="statWebhooks">…</div><div class="stat-label">Webhook đang bật</div></article>
    <article class="card stat"><div class="stat-value" id="statProxies">…</div><div class="stat-label">Proxy đã cấu hình</div></article>
  </section>

  <section class="section">
    <div class="section-title"><h2>Tính năng</h2><span class="badge badge-success">Sẵn sàng</span></div>
    <div class="grid grid-3">
      <a class="card hover" href="./zalo-login" style="text-decoration:none"><div class="feature-icon">▣</div><h3 class="card-title">Đăng nhập Zalo</h3><p class="card-text">Quét QR, chọn proxy và thêm nhiều tài khoản vào server.</p></a>
      <a class="card hover" href="./accounts" style="text-decoration:none"><div class="feature-icon">◎</div><h3 class="card-title">Tài khoản</h3><p class="card-text">Xem trạng thái, ownId, số điện thoại và proxy của từng tài khoản.</p></a>
      <a class="card hover" href="./account-webhook-manager" style="text-decoration:none"><div class="feature-icon">⌁</div><h3 class="card-title">Webhook đa đích</h3><p class="card-text">Một ID tài khoản có thể gửi message, group event và reaction đến nhiều webhook.</p></a>
      <a class="card hover" href="./messages" style="text-decoration:none"><div class="feature-icon">✦</div><h3 class="card-title">Theo dõi tin nhắn</h3><p class="card-text">Xem sự kiện thời gian thực và sao chép thread_id nhanh chóng.</p></a>
      <a class="card hover" href="./proxies" style="text-decoration:none"><div class="feature-icon">◌</div><h3 class="card-title">Proxy</h3><p class="card-text">Thêm, xóa và theo dõi số tài khoản đang sử dụng từng proxy.</p></a>
      <a class="card hover" href="./list" style="text-decoration:none"><div class="feature-icon">{ }</div><h3 class="card-title">Tài liệu API</h3><p class="card-text">Tra cứu các endpoint Zalo Server và ví dụ payload tích hợp.</p></a>
      <a class="card hover" href="./change-password" style="text-decoration:none"><div class="feature-icon">⌘</div><h3 class="card-title">Bảo mật</h3><p class="card-text">Đổi mật khẩu tài khoản quản trị đang đăng nhập.</p></a>
      <% if (isAdmin) { %>
      <a class="card hover" href="./user-management" style="text-decoration:none"><div class="feature-icon">♙</div><h3 class="card-title">Người dùng</h3><p class="card-text">Quản lý người dùng và quyền truy cập Zalo Bot Server.</p></a>
      <% } %>
      <article class="card"><div class="feature-icon">✓</div><h3 class="card-title">Tương thích Home Assistant</h3><p class="card-text">Giao diện dùng tài nguyên cục bộ, đường dẫn tương đối và API có xác thực session.</p></article>
    </div>
  </section>
  <% } %>
</main>
<% if (authenticated) { %>
<script>
(async () => {
  const set = (id, value) => { document.getElementById(id).textContent = String(value); };
  try {
    const [accounts, webhookAccounts, proxies] = await Promise.all([
      zaloUi.json('/api/accounts').catch(() => ({data:[]})),
      zaloUi.json('/api/webhook-accounts').catch(() => ({data:[]})),
      zaloUi.json('/api/proxies').catch(() => ({data:[]})),
    ]);
    const wh = Array.isArray(webhookAccounts.data) ? webhookAccounts.data : [];
    set('statAccounts', Array.isArray(accounts.data) ? accounts.data.length : 0);
    set('statWebhookAccounts', wh.length);
    set('statWebhooks', wh.reduce((sum, item) => sum + Number(item.enabledCount || 0), 0));
    set('statProxies', Array.isArray(proxies.data) ? proxies.data.length : 0);
  } catch {
    ['statAccounts','statWebhookAccounts','statWebhooks','statProxies'].forEach(id => set(id, '—'));
  }
})();
</script>
<% } %>

<%- include('partials/footer') %>
